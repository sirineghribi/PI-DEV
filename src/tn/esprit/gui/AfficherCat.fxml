<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="359.0" prefWidth="705.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.gui.AfficherCatController">
   <children>
      <ImageView fitHeight="479.0" fitWidth="733.0" layoutX="-28.0" layoutY="-53.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../esprit/images/fond.png" />
         </image>
      </ImageView>
      <TableView fx:id="tabCat" layoutX="98.0" layoutY="69.0" prefHeight="226.0" prefWidth="481.0">
        <columns>
          <TableColumn fx:id="id_cat" prefWidth="75.0" text="id_cat" />
          <TableColumn fx:id="nom_cat" prefWidth="75.0" text="nom_cat" />
            <TableColumn fx:id="lieu" prefWidth="75.0" text="lieu" />
        </columns>
      </TableView>
      <Button layoutX="250.0" layoutY="307.0" mnemonicParsing="false" onAction="#supprimerCat" text="Supprimer" />
      <Button fx:id="mod_btn" layoutX="430.0" layoutY="307.0" mnemonicParsing="false" onAction="#modifierCat" text="modifier" />
   </children>
</AnchorPane>
