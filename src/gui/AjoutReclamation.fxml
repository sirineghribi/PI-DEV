            <Font size="13.0" />
         </font>
      </Button>
      <ComboBox fx:id="type" layoutX="469.0" layoutY="132.0" prefWidth="150.0" />
      <Button fx:id="consrec" layoutX="533.0" layoutY="323.0" mnemonicParsing="false" onAction="#consulteReclamation" prefHeight="30.0" prefWidth="106.0" text="Consulter">
         <font>
            <Font name="Arial" size="13.0" />
         </font></Button>
      <Button fx:id="accueil" layoutX="-1.0" layoutY="249.0" mnemonicParsing="false" onAction="#open_accueil" prefHeight="26.0" prefWidth="187.0" text="Accueil" textFill="WHITE" />
      <ImageView fitHeight="121.0" fitWidth="128.0" layoutX="33.0" layoutY="6.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/logoforinterplanetary.png" />
         </image>
      </ImageView>
      <Button fx:id="profil" layoutX="-1.0" layoutY="220.0" mnemonicParsing="false" onAction="#open_profil" prefHeight="26.0" prefWidth="187.0" text="Profil" textFill="WHITE" />
      <Button fx:id="abonnement" layoutY="309.0" mnemonicParsing="false" onAction="#open_abonnement" prefHeight="26.0" prefWidth="187.0" text="Abonnement" textFill="WHITE" />
      <Button fx:id="rec" layoutY="279.0" mnemonicParsing="false" onAction="#open_reclamation" prefHeight="26.0" prefWidth="187.0" text="Reclamation" textFill="WHITE" />
      <Label layoutX="267.0" layoutY="39.0" text="Ajouter reclamation" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="formation" layoutY="338.0" mnemonicParsing="false" onAction="#open_formation" prefHeight="18.0" prefWidth="187.0" text="Formation" textFill="WHITE" />
      <Button fx:id="vehicule" layoutX="-1.0" layoutY="366.0" mnemonicParsing="false" onAction="#open_vehicule" prefHeight="18.0" prefWidth="187.0" text="Vehicules" textFill="WHITE" />
