<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="394.0" prefWidth="893.0" style="-fx-background-color: purple;" stylesheets="@/Styles/dahsboard.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AjoutReclamationController">
   <children>
      <ImageView fitHeight="402.0" fitWidth="712.0" layoutX="187.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/fond.png" />
         </image>
      </ImageView>
      <Label fx:id="ltype" layoutX="331.0" layoutY="135.0" prefHeight="17.0" prefWidth="44.0" text="Type:" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="13.0" />
         </font></Label>
      <Label fx:id="ldesc" layoutX="332.0" layoutY="197.0" text="Description:" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="13.0" />
         </font></Label>
      <TextArea fx:id="txtdesc" layoutX="469.0" layoutY="197.0" prefHeight="72.0" prefWidth="211.0" />
      <Button fx:id="btn" layoutX="395.0" layoutY="323.0" mnemonicParsing="false" onAction="#addRec" prefHeight="29.0" prefWidth="106.0" text="Envoyer" textOverrun="CLIP">
