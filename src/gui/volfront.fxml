<AnchorPane id="AnchorPane" prefHeight="394.0" prefWidth="893.0" style="-fx-background-color: purple;" stylesheets="@/Styles/dahsboard.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.VolfrontController">
