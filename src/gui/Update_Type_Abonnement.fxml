      <Button fx:id="update_type" layoutX="100.0" layoutY="244.0" mnemonicParsing="false" onAction="#update_type" prefHeight="25.0" prefWidth="63.0" text="Update" />
      <Button fx:id="cancel_type" layoutX="14.0" layoutY="244.0" mnemonicParsing="false" onAction="#cancel_update" prefHeight="25.0" prefWidth="63.0" text="cancel" />
