<AnchorPane id="AnchorPane" prefHeight="285.0" prefWidth="184.0" stylesheets="@/Styles/dahsboard.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Update_Type_AbonnementController">
