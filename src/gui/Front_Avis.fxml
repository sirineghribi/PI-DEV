            <Font name="Bodoni MT Bold" size="12.0" />
         </font></Button>
      <ScrollPane id="ScrollPane" fx:id="scroll" layoutX="377.0" layoutY="98.0" prefHeight="200.0" prefWidth="350.0" style="-fx-background-color: #990dac;" styleClass="jspTrack" stylesheets="@../Styles/dahsboard.css">
         <content>
            <GridPane fx:id="grd" prefHeight="411.0" prefWidth="334.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
            </GridPane>
         </content>
      </ScrollPane>
      <Button fx:id="accueil" layoutX="1.0" layoutY="249.0" mnemonicParsing="false" onAction="#open_accueil" prefHeight="26.0" prefWidth="187.0" text="Accueil" textFill="WHITE" />
      <ImageView fitHeight="121.0" fitWidth="128.0" layoutX="35.0" layoutY="6.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/logoforinterplanetary.png" />
         </image>
      </ImageView>
      <Button fx:id="profil" layoutX="1.0" layoutY="220.0" mnemonicParsing="false" onAction="#open_profil" prefHeight="26.0" prefWidth="187.0" text="Profil" textFill="WHITE" />
      <Button fx:id="rec" layoutX="2.0" layoutY="279.0" mnemonicParsing="false" onAction="#open_reclamation" prefHeight="26.0" prefWidth="187.0" text="Reclamation" textFill="WHITE" />
      <Button fx:id="abonnement" layoutX="2.0" layoutY="309.0" mnemonicParsing="false" onAction="#open_abonnement" prefHeight="26.0" prefWidth="187.0" text="Abonnement" textFill="WHITE" />
      <Button fx:id="formation" layoutX="2.0" layoutY="339.0" mnemonicParsing="false" onAction="#open_formation" prefHeight="18.0" prefWidth="187.0" text="Formation" textFill="WHITE" />
      <Button fx:id="vehicule" layoutX="1.0" layoutY="367.0" mnemonicParsing="false" onAction="#open_vehicule" prefHeight="18.0" prefWidth="187.0" text="Vehicules" textFill="WHITE" />
   </children>
</AnchorPane>
