<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="427.0" prefWidth="723.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.AfficherCatController">
   <children>
      <ImageView fx:id="gb" fitHeight="460.0" fitWidth="816.0" layoutX="-10.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/fond.png" />
         </image>
      </ImageView>
      <TableView fx:id="tabCat" layoutX="283.0" layoutY="116.0" prefHeight="226.0" prefWidth="229.0">
        <columns>
          <TableColumn fx:id="id_cat" prefWidth="75.0" text="id_cat" />
          <TableColumn fx:id="nom_cat" prefWidth="75.0" text="nom_cat" />
            <TableColumn fx:id="lieu" prefWidth="75.0" text="lieu" />
        </columns>
      </TableView>
      <Button layoutX="271.0" layoutY="361.0" mnemonicParsing="false" onAction="#supprimerCat" text="Supprimer" />
      <Button fx:id="mod_btn" layoutX="363.0" layoutY="361.0" mnemonicParsing="false" onAction="#modifierCat" prefHeight="26.0" prefWidth="71.0" text="modifier" />
      <Button fx:id="vol" layoutX="91.0" mnemonicParsing="false" onAction="#open_vol" prefHeight="34.0" prefWidth="102.0" text="Vols" />
      <Button fx:id="user" layoutX="-10.0" mnemonicParsing="false" onAction="#openuser" prefHeight="34.0" prefWidth="102.0" text="Utilisateurs" />
      <Button fx:id="avis" layoutX="193.0" mnemonicParsing="false" onAction="#open_avis" prefHeight="34.0" prefWidth="150.0" text="Reclamation_avis" />
      <Button fx:id="type_ab" layoutX="343.0" mnemonicParsing="false" onAction="#open_type_ab" prefHeight="34.0" prefWidth="150.0" text="Type abonnement" />
      <Button fx:id="formation" layoutX="493.0" mnemonicParsing="false" onAction="#open_formation" prefHeight="34.0" prefWidth="189.0" text="Formations_maintenances" />
      <Button layoutX="682.0" mnemonicParsing="false" onAction="#open_vehicule" prefHeight="34.0" prefWidth="124.0" text="Vehicules" />
      <Button layoutX="452.0" layoutY="361.0" mnemonicParsing="false" onAction="#ajout_onclick" prefHeight="26.0" prefWidth="71.0" text="Ajouter" />
   </children>
</AnchorPane>
