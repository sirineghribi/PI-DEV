            <Image url="@../../../esprit/images/fond.png" />
         </image>
      </ImageView>
      <Label layoutX="14.0" layoutY="56.0" text="nom vehicule" textFill="#fcf1f1" />
      <Label layoutX="16.0" layoutY="152.0" text="poids supporté" textFill="#f2eded" />
      <Label layoutX="16.0" layoutY="204.0" text="vitesse" textFill="#f5eded" />
      <Label layoutX="16.0" layoutY="258.0" text="nbr passager" textFill="#f5efef" />
      <TextField fx:id="tf_nom" layoutX="130.0" layoutY="51.0" />
      <TextField fx:id="tf_poid" layoutX="130.0" layoutY="152.0" />
      <TextField fx:id="tf_vitesse" layoutX="130.0" layoutY="199.0" />
      <TextField fx:id="tf_passager" layoutX="130.0" layoutY="253.0" />
      <Button layoutX="410.0" layoutY="276.0" mnemonicParsing="false" onAction="#ajouter_vehicule" text="Ajouter" />
      <Button layoutY="-1.0" mnemonicParsing="false" text="Gestion Vehicule" />
      <Button layoutX="130.0" layoutY="-1.0" mnemonicParsing="false" onAction="#gestion_categorie" text="Gestion Categorie" />
