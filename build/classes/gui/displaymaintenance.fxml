<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Bloom?>
<?import javafx.scene.effect.Light.Distant?>
<?import javafx.scene.effect.Lighting?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="427.0" prefWidth="723.0" stylesheets="@/Styles/dahsboard.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.DisplaymaintenanceController">
   <children>
      <ImageView fitHeight="460.0" fitWidth="816.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/fond.png" />
         </image>
      </ImageView>
      <TableView fx:id="tablemaint" layoutX="137.0" layoutY="133.0" prefHeight="266.0" prefWidth="505.0">
        <columns>
          <TableColumn fx:id="idv" prefWidth="116.00004577636719" text="ID vehicule" />
          <TableColumn fx:id="statusmaint" prefWidth="95.99993896484375" text="statut" />
            <TableColumn fx:id="timemaint" prefWidth="109.60003662109375" text="duree " />
            <TableColumn fx:id="coutmaint" minWidth="0.0" prefWidth="66.39996337890625" text="cout " />
            <TableColumn fx:id="categoryveh" prefWidth="141.5999755859375" text="categorie " />
        </columns>
         <effect>
            <Lighting>
               <bumpInput>
                  <Bloom />
               </bumpInput>
               <light>
                  <Light.Distant />
               </light>
            </Lighting>
         </effect>
      </TableView>
      <Button fx:id="maintajout" layoutX="685.0" layoutY="260.0" mnemonicParsing="false" onAction="#addmaintenance" prefHeight="26.0" prefWidth="78.0" text="modifier" />
      <TextField fx:id="search" layoutX="137.0" layoutY="87.0" prefHeight="26.0" prefWidth="439.0" />
      <Button fx:id="sorting" layoutX="592.0" layoutY="87.0" mnemonicParsing="false" onAction="#sort" prefHeight="26.0" prefWidth="50.0" text="sort" />
      <Button fx:id="vol" layoutX="101.0" mnemonicParsing="false" onAction="#open_vol" prefHeight="34.0" prefWidth="102.0" text="Vols" />
      <Button fx:id="user" mnemonicParsing="false" onAction="#openuser" prefHeight="34.0" prefWidth="102.0" text="Utilisateurs" />
      <Button fx:id="avis" layoutX="203.0" mnemonicParsing="false" onAction="#open_avis" prefHeight="34.0" prefWidth="150.0" text="Reclamation_avis" />
      <Button fx:id="type_ab" layoutX="353.0" mnemonicParsing="false" onAction="#open_type_ab" prefHeight="34.0" prefWidth="150.0" text="Type abonnement" />
      <Button fx:id="formation" layoutX="503.0" mnemonicParsing="false" onAction="#open_formation" prefHeight="34.0" prefWidth="189.0" text="Formations_maintenances" />
      <Button layoutX="692.0" mnemonicParsing="false" onAction="#open_vehicule" prefHeight="34.0" prefWidth="124.0" text="Vehicules" />
      <Button fx:id="formation" layoutX="-1.0" layoutY="35.0" mnemonicParsing="false" onAction="#open_formation" prefHeight="34.0" prefWidth="124.0" text="Formations" />
      <Button fx:id="ajouter_btn" layoutX="683.0" layoutY="215.0" mnemonicParsing="false" onAction="#ajouter_onclick" prefHeight="26.0" prefWidth="78.0" text="Ajouter" />
      <Button fx:id="stat" layoutX="685.0" layoutY="310.0" mnemonicParsing="false" onAction="#stat_onclick" prefHeight="26.0" prefWidth="78.0" text="Stat" />
   </children>
</AnchorPane>
