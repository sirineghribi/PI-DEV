<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" fx:id="card" prefHeight="314.0" prefWidth="389.0" stylesheets="@/Styles/dahsboard.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.CarteController">
   <children>
      <ImageView fitHeight="372.0" fitWidth="700.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../esprit/images/fond.png" />
         </image>
      </ImageView>
      <TableView fx:id="CardTable" layoutX="211.0" layoutY="87.0" onMouseClicked="#selected" prefHeight="151.0" prefWidth="238.0">
        <columns>
          <TableColumn fx:id="numCol" prefWidth="69.5999755859375" text="Numero" />
          <TableColumn fx:id="nbrCol" prefWidth="82.4000244140625" text="NBR POINTS" />
            <TableColumn fx:id="idCol" prefWidth="82.4000244140625" text="ID_User" />
        </columns>
      </TableView>
      <Button fx:id="supprimer" layoutX="96.0" layoutY="286.0" mnemonicParsing="false" onAction="#supprimer" text="Supprimer" />
      <Button fx:id="back" layoutX="501.0" layoutY="286.0" mnemonicParsing="false" onAction="#back" prefHeight="26.0" prefWidth="71.0" text="Back" />
      <TextField fx:id="idT" layoutX="151.0" layoutY="340.0" onMouseClicked="#selected" visible="false" />
   </children>
</AnchorPane>
