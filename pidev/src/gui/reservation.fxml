<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="310.0" prefWidth="600.0" stylesheets="@/Styles/dahsboard.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ReservationController">
   <children>
      <ImageView fitHeight="444.0" fitWidth="788.0" layoutX="-1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../image/fond.png" />
         </image>
      </ImageView>
      <Button fx:id="accueil" layoutX="646.0" layoutY="37.0" mnemonicParsing="false" onAction="#accueil" text="Accueil" textFill="WHITE" />
      <Label layoutX="257.0" layoutY="63.0" text="Historique de vos reservations" textFill="WHITE">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TableView fx:id="tableview" layoutX="42.0" layoutY="149.0" prefHeight="200.0" prefWidth="670.0" stylesheets="@../Styles/dahsboard.css">
        <columns>
          <TableColumn fx:id="date" prefWidth="111.0" text="Date reservation" />
          <TableColumn fx:id="montant" prefWidth="111.0" text="Montant" />
            <TableColumn fx:id="destination" prefWidth="111.0" text="Destination" />
            <TableColumn fx:id="date_vol" minWidth="4.0" prefWidth="111.0" text="Date vol" />
            <TableColumn fx:id="etat" minWidth="0.0" prefWidth="111.0" text="Etat" />
            <TableColumn fx:id="details" minWidth="0.0" prefWidth="111.0" text="Details" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
